{
  "config": {
    "flow_title": "{name}",
    "step": {
      "bluetooth_confirm": {
        "description": "Set up {name}? Make sure the LifeSpan Fit app is closed, since the console only accepts one Bluetooth connection.",
        "data": {
          "unit": "Unit shown on the console"
        }
      },
      "user": {
        "description": "Choose the LifeSpan console to set up.",
        "data": {
          "address": "Device",
          "unit": "Unit shown on the console"
        }
      }
    },
    "abort": {
      "already_configured": "Device is already configured",
      "no_devices_found": "No LifeSpan console found over Bluetooth. Make sure the console is on and within range of a Bluetooth adapter or ESPHome Bluetooth proxy."
    }
  },
  "options": {
    "step": {
      "init": {
        "data": {
          "unit": "Unit shown on the console",
          "idle_interval": "Seconds between polls while in standby"
        }
      }
    }
  },
  "entity": {
    "sensor": {
      "status": {
        "name": "Status",
        "state": {
          "standby": "Standby",
          "running": "Running",
          "paused": "Paused",
          "summary": "Summary",
          "unknown": "Unknown"
        }
      },
      "steps": {
        "name": "Steps"
      },
      "session_time": {
        "name": "Session time"
      },
      "calories": {
        "name": "Calories"
      },
      "last_session_ended": {
        "name": "Last session ended"
      },
      "last_session_duration": {
        "name": "Last session duration"
      },
      "last_session_steps": {
        "name": "Last session steps"
      },
      "last_session_distance": {
        "name": "Last session distance"
      },
      "last_session_calories": {
        "name": "Last session calories"
      },
      "last_session_average_speed": {
        "name": "Last session average speed"
      }
    },
    "binary_sensor": {
      "running": {
        "name": "Running"
      }
    },
    "event": {
      "session": {
        "name": "Session",
        "state_attributes": {
          "event_type": {
            "state": {
              "session_completed": "Session completed"
            }
          }
        }
      }
    }
  }
}
